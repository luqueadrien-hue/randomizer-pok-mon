{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('ownerUid').val() === auth.uid && newData.child('hostIds').child(auth.uid).val() === true && newData.child('created').isNumber()",
        "ownerUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "created": {
          ".validate": "newData.isNumber()"
        },
        "parentRoom": {
          ".validate": "newData.isString()"
        },
        "tableNumber": {
          ".validate": "newData.isNumber()"
        },
        "tableCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
        },
        "hostIds": {
          "$uid": {
            ".validate": "newData.isBoolean() && newData.val() === true && $uid === auth.uid"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).exists() && (data.exists() || !root.child('rooms').child($room).child('parentRoom').exists() || root.child('rooms').child($room).child('players').numChildren() < 2)",
            ".validate": "newData.hasChildren(['name','role','online']) && newData.numChildren() === 3 && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 24 && newData.child('role').isString() && newData.child('role').val() === (root.child('rooms').child($room).child('ownerUid').val() === $uid ? 'host' : 'player') && newData.child('online').isBoolean()"
          }
        },
        "seats": {
          "$seat": {
            ".write": "auth != null && root.child('rooms').child($room).child('ownerUid').val() === auth.uid && ($seat === '1' || $seat === '2')",
            ".validate": "newData.isString() && root.child('rooms').child($room).child('players').child(newData.val()).exists()"
          },
          ".validate": "!newData.child('1').exists() || !newData.child('2').exists() || newData.child('1').val() !== newData.child('2').val()"
        },
        "started": {
          ".write": "auth != null && root.child('rooms').child($room).child('ownerUid').val() === auth.uid",
          ".validate": "newData.isBoolean()"
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (root.child('rooms').child($room).child('started').val() === true || root.child('rooms').child($room).child('ownerUid').val() === auth.uid)"
        },
        "questionDuel": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (root.child('rooms').child($room).child('started').val() === true || root.child('rooms').child($room).child('ownerUid').val() === auth.uid)"
        },
        "hangman": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (root.child('rooms').child($room).child('started').val() === true || root.child('rooms').child($room).child('ownerUid').val() === auth.uid)"
        },
        "trioPrivate": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('players').child(auth.uid).exists()"
          }
        },
        "trioProgress": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('players').child(auth.uid).exists()"
          }
        },
        "impossibleDilemma": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (root.child('rooms').child($room).child('started').val() === true || root.child('rooms').child($room).child('ownerUid').val() === auth.uid)"
        },
        "blindDraft": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (root.child('rooms').child($room).child('started').val() === true || root.child('rooms').child($room).child('ownerUid').val() === auth.uid)"
        },
        "auctionRound": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (root.child('rooms').child($room).child('started').val() === true || root.child('rooms').child($room).child('ownerUid').val() === auth.uid)"
        },
        "modulo": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (root.child('rooms').child($room).child('started').val() === true || root.child('rooms').child($room).child('ownerUid').val() === auth.uid)"
        },
        "trainerMarket": {
          ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && root.child('rooms').child($room).child('started').val() === true",
          ".validate": "newData.child('version').val() === 2 && newData.child('game').isString() && newData.child('catalog').numChildren() > 0 && newData.child('catalog').numChildren() <= 2000 && newData.child('budget').isNumber() && newData.child('purchaseCount').isNumber()"
        },
        "trainerDraft6": {
          ".write": "auth != null && root.child('rooms').child($room).child('started').val() === true && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (!data.exists() ? root.child('rooms').child($room).child('ownerUid').val() === auth.uid : true)",
          ".validate": "newData.child('version').val() === 2 && (newData.child('game').val() === 'sv' || newData.child('game').val() === 'swsh' || newData.child('game').val() === 'bdsp') && newData.child('gameId').isString() && newData.child('boxes').child('1').numChildren() === 5 && newData.child('boxes').child('2').numChildren() === 5 && newData.child('choices').child('1').child('gameId').val() === newData.child('gameId').val() && newData.child('choices').child('2').child('gameId').val() === newData.child('gameId').val() && newData.child('choices').child('1').child('entries').numChildren() <= 6 && newData.child('choices').child('2').child('entries').numChildren() <= 6 && (!data.exists() || root.child('rooms').child($room).child('ownerUid').val() === auth.uid || (newData.child('gameId').val() === data.child('gameId').val() && newData.child('boxes').val() === data.child('boxes').val() && newData.child('budget').val() === data.child('budget').val() && newData.child('boxMode').val() === data.child('boxMode').val()))"
        },
        "zoneWheel": {
          ".write": "auth != null && root.child('rooms').child($room).child('started').val() === true && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
          ".validate": "newData.child('version').val() === 3 && newData.child('game').isString() && newData.child('rounds').numChildren() <= 6"
        }
      }
    }
  }
}
